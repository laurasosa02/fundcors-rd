# FUNDCORSRD backend — environment variables.
#
# Copy this file to `.env` (or otherwise set these in your process
# environment / hosting control panel) and fill in real values. Never
# commit a file containing real secrets.

# Django's cryptographic secret key. Required — the app refuses to start
# without it. Generate a long random value, e.g.:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=changeme-generate-a-long-random-secret-key

# Which settings module Django loads. Set to config.settings.prod in
# production (manage.py/wsgi default to config.settings.dev otherwise).
DJANGO_SETTINGS_MODULE=config.settings.prod

# Comma-separated list of hostnames this site is allowed to serve
# (Django's ALLOWED_HOSTS), e.g. "example.org,www.example.org".
DJANGO_ALLOWED_HOSTS=example.org,www.example.org

# Origin (scheme + host, no trailing slash) of the separately-built
# frontend, used for CORS/CSRF trust in production.
FRONTEND_ORIGIN=https://app.example.org

# Mailbox that receives new-registration notification emails for admin
# review. Defaults to fundcorsrd@gmail.com if unset.
ADMIN_NOTIFY_EMAIL=fundcorsrd@gmail.com

# SMTP server hostname used to send outgoing email in production.
EMAIL_HOST=smtp.example.org

# SMTP server port. Defaults to 587 if unset.
EMAIL_PORT=587

# SMTP account username used to authenticate with EMAIL_HOST.
EMAIL_HOST_USER=notifications@example.org

# SMTP account password used to authenticate with EMAIL_HOST. Never
# commit a real value.
EMAIL_HOST_PASSWORD=changeme-smtp-password

# Whether to use TLS when talking to EMAIL_HOST. Accepts "True"/"False"
# (also "1"/"yes" as truthy); defaults to "True" if unset.
EMAIL_USE_TLS=True

# Download link for RINEX data, shown to approved users on the
# Descargas Autorizadas page.
DOWNLOAD_URL_RINEX=https://example.org/downloads/rinex

# Download link for "Manzanero" data, shown to approved users on the
# Descargas Autorizadas page.
DOWNLOAD_URL_MANZANERO=https://example.org/downloads/manzanero

# Download link for "Soluciones" data, shown to approved users on the
# Descargas Autorizadas page.
DOWNLOAD_URL_SOLUCIONES=https://example.org/downloads/soluciones

# Download link for "Hojas" data, shown to approved users on the
# Descargas Autorizadas page.
DOWNLOAD_URL_HOJAS=https://example.org/downloads/hojas
