# Copy this file to scripts/deploy.env (gitignored) and fill in real values.
# Never commit deploy.env — it holds real hosting credentials.

# FTP/SFTP credentials for the Network Solutions account.
DEPLOY_FTP_HOST=ftp.fundcorsrd.com
DEPLOY_FTP_USER=changeme
# "ftp" or "sftp" — prefer sftp if the account supports it.
DEPLOY_FTP_PROTOCOL=sftp
# Leave empty for the protocol default (22 for sftp, 21 for ftp).
# This account's SFTP listens on 2222.
DEPLOY_FTP_PORT=2222

# Optional. If you leave DEPLOY_FTP_PASS out (recommended), deploy.sh asks for
# the password each run and it never touches disk. Set it only for unattended
# runs, and keep in mind deploy.env then holds a real hosting password.
#DEPLOY_FTP_PASS=

# Remote path the frontend's dist/ directory should be mirrored into
# (the document root serving fundcorsrd.com).
DEPLOY_FRONTEND_REMOTE_PATH=/public_html

# The backend is not deployed from here — it runs on PythonAnywhere and is
# updated separately (git pull). See docs/deployment-guide.md, section 3-bis.
