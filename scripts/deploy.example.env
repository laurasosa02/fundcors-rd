# Copy this file to scripts/deploy.env (gitignored) and fill in real values.
# Never commit deploy.env — it holds real hosting credentials.

# FTP/SFTP credentials for the Network Solutions account.
DEPLOY_FTP_HOST=ftp.fundcorsrd.com
DEPLOY_FTP_USER=changeme
DEPLOY_FTP_PASS=changeme
# "ftp" or "sftp" — prefer sftp if the account supports it.
DEPLOY_FTP_PROTOCOL=sftp

# Remote path the frontend's dist/ directory should be mirrored into
# (the document root serving fundcorsrd.com).
DEPLOY_FRONTEND_REMOTE_PATH=/public_html

# Remote path the backend/ directory should be mirrored into
# (wherever the Python App is configured to run from).
DEPLOY_BACKEND_REMOTE_PATH=/fundcorsrd-backend

# Optional: if the hosting account has SSH access, set this to the
# host (user@host) so deploy.sh can also run pip install / migrate /
# collectstatic / restart remotely. Leave empty if SSH isn't available
# — deploy.sh will skip that part and print a manual checklist instead.
DEPLOY_SSH_HOST=
